# Perfil privado, absoluto e fora do repositório. Nunca incluir em artefatos.
UPSELLER_PROFILE_DIR=/opt/axios-factory-runtime/upseller-profile
MAX_PAGES=1000
OUTPUT_DIR=data
BUSINESS_TIMEZONE=America/Sao_Paulo
OPERATIONAL_TOP_N=10

# Notificações: defaults seguros, envio desabilitado
WHATSAPP_TOP_PRODUCTS=5
NOTIFICATION_BOOTSTRAP_MODE=silent
NOTIFICATION_DRY_RUN=true

# Evolution API: URL base (sem /message/sendText/instance)
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_RECIPIENT_JID=
WHATSAPP_TIMEOUT_MS=10000
# Quantos pedidos listar por prioridade (atrasados/críticos/urgentes) na mensagem
WHATSAPP_LIST_LIMIT=8

# Painel de pedidos (celular / tag NFC)
# PANEL_TOKEN: chave secreta do link, 24+ caracteres [A-Za-z0-9_-]. Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PANEL_TOKEN=
# Endereço público (https). O link enviado fica PANEL_PUBLIC_URL/p/PANEL_TOKEN
PANEL_PUBLIC_URL=
PANEL_HOST=127.0.0.1
PANEL_PORT=3100
# Palavras no nome do produto que exigem nome/personalização na nota do UpSeller
PERSONALIZATION_KEYWORDS=natal,bolinha
